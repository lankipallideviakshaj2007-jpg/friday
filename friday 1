     def handle_voice_status(self, status, error_msg=None):
         """Callback from VoiceManager when status changes."""
         self.assistant_state = status
         if status == "ERROR" and error_msg:
             self.show_error(error_msg)
         elif status == "LISTENING":
             self.after(0, lambda: self.transcript_lbl.configure(text="Sensing audio..."))

     def handle_voice_input(self, text):
         """Processes finalized speech from VoiceManager."""
         self.last_transcript = text
         self.after(0, lambda: self.transcript_lbl.configure(text=f'"{text}"'))

         # Parse commands
         threading.Thread(target=self.parse_and_execute, args=(text,), daemon=True).start()

     def speak_and_display(self, response_text):
         """Speak out loud and display visually."""
         self.last_response = response_text
         self.after(0, lambda: self.response_lbl.configure(text=response_text))
         self.log_history("Siri/FRIDAY", "Speak", response_text, "Success")
         self.voice.speak(response_text)

     def show_error(self, err_text):
         self.assistant_state = "ERROR"
         self.last_response = err_text
         self.after(0, lambda: self.response_lbl.configure(text=f"Error: {err_text}"))
         self.log_history("System", "Error", err_text, "Failed")
         self.voice.speak("Sir, an error has occurred.")

