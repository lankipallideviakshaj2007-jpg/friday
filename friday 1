     # ANIMATIONS: Glowing Interactive Sphere & Particles
     # =====================================================================
     def animate(self):
         self.canvas.delete("all")
         w, h = self.canvas.winfo_width(), self.canvas.winfo_height()
         if w < 10: w, h = 750, 400
         cx, cy = w/2, h/2

         # Draw a beautiful digital futuristic radar grid behind the sphere
         grid_color = "#0e1627"
         self.canvas.create_oval(cx - 190, cy - 190, cx + 190, cy + 190, outline=grid_color, width=1)
         self.canvas.create_oval(cx - 130, cy - 130, cx + 130, cy + 130, outline=grid_color, width=1)
         self.canvas.create_line(cx - 210, cy, cx + 210, cy, fill=grid_color, width=1)
         self.canvas.create_line(cx, cy - 210, cx, cy + 210, fill=grid_color, width=1)

         # Update and Draw floating particles
         for p in self.particles:
             p["x"] += p["speed"] * math.cos(p["angle"])
             p["y"] += p["speed"] * math.sin(p["angle"])
             # Bounce particles off borders
             if p["x"] < 20 or p["x"] > w - 20: p["angle"] = math.pi - p["angle"]
             if p["y"] < 20 or p["y"] > h - 20: p["angle"] = -p["angle"]

             # Glow around sphere
             dist = math.sqrt((p["x"] - cx)**2 + (p["y"] - cy)**2)
             alpha_color = "#12253f" if dist > 150 else "#00f0ff"
             self.canvas.create_oval(p["x"]-p["radius"], p["y"]-p["radius"], p["x"]+p["radius"], p["y"]+p["radius"], fill=alpha_color,
 outline="")

         # Core Sphere Size & Color state logic
         radius = 75
         self.current_mic_level = self.voice.input_level

         if self.assistant_state == "LISTENING":
             # Reactive cyan sound wave rings that expand with real microphone sound intensity
             reaction = min(self.current_mic_level / 4.0, 70.0)
             radius = 80 + reaction
             color = "#00f0ff" # Neon Cyan
             glow = "#0284c7"

             # Soundwave outer rings
             for r_factor in [1.3, 1.6]:
                 ring_r = radius * r_factor
                 self.canvas.create_oval(cx-ring_r, cy-ring_r, cx+ring_r, cy+ring_r, outline="#00f0ff", width=1)

         elif self.assistant_state == "THINKING":
             # Orb of deep purple violet with spinning rings
             radius = 70 + 5 * math.sin(self.anim_frame * 0.25)
             color = "#a78bfa" # Lavender violet
             glow = "#6d28d9"

             # Orbiting white/purple dots
             for i in range(5):
                 angle = (self.anim_frame * 0.08) + (i * (2 * math.pi / 5))
                 ox = cx + (radius + 40) * math.cos(angle)
                 oy = cy + (radius + 20) * math.sin(angle)
                 self.canvas.create_oval(ox-4, oy-4, ox+4, oy+4, fill="#ffffff", outline="#a78bfa")

             # Rotating rings
             self.canvas.create_oval(cx - radius - 25, cy - 10, cx + radius + 25, cy + 10, outline="#a78bfa", width=1)

         elif self.assistant_state == "SPEAKING":
             # Electric blue responsive pulsating wave
             radius = 75 + 18 * math.sin(self.anim_frame * 0.3)
             color = "#2563eb" # Electric Blue
             glow = "#1d4ed8"

             # Draw wave lines mimicking audio waves
             for i in range(-5, 6):
                 wave_h = 35 * math.sin(self.anim_frame * 0.4 + i)
                 wx = cx + (i * 12)
                 self.canvas.create_line(wx, cy - wave_h, wx, cy + wave_h, fill="#00f0ff", width=2)

         elif self.assistant_state == "EXECUTING":
             # Rapid orange/amber breathing pulse
             radius = 65 + 25 * abs(math.sin(self.anim_frame * 0.6))
             color = "#f59e0b" # Orange amber
             glow = "#b45309"

         elif self.assistant_state == "SUCCESS":
             # Green success ring
             radius = 85
             color = "#10b981" # Green emerald
             glow = "#047857"
             self.canvas.create_oval(cx - 120, cy - 120, cx + 120, cy + 120, outline="#10b981", width=3)

         elif self.assistant_state == "ERROR":
             # Angry breathing red/orange
             radius = 75 + 3 * math.sin(self.anim_frame * 0.1)
             color = "#ef4444" # Red
             glow = "#7f1d1d"
             self.canvas.create_oval(cx-radius - 15, cy-radius - 15, cx+radius + 15, cy+radius + 15, outline="#ef4444", width=1)

         else: # IDLE (Slow breathing blue pulsing glow)
             radius = 70 + 4 * math.sin(self.anim_frame * 0.06)
             color = "#0f172a" # Deep dark blue
             glow = "#1e3a8a"

             # Subtle breathing aura rings
             self.canvas.create_oval(cx-radius - 10, cy-radius - 10, cx+radius + 10, cy+radius + 10, outline="#1e293b", width=1)

         # Draw actual sphere core
         self.canvas.create_oval(cx-radius, cy-radius, cx+radius, cy+radius, fill=color, outline="#ffffff", width=2)

         self.anim_frame += 1
         self.after(30, self.animate)

