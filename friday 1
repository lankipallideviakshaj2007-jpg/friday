     def toggle_listening(self):
         self.continuous_listening = not self.continuous_listening
         if self.continuous_listening:
             self.voice.start_listening()
             self.btn_mic.configure(text="🎤 Listen On", fg_color="#059669", hover_color="#047857")
             self.speak_and_display("Microphone listening loop activated.")
         else:
             self.voice.stop_listening()
             self.btn_mic.configure(text="🎤 Listen Off", fg_color="#4b5563", hover_color="#374151")
             self.speak_and_display("Microphone muted.")

     def toggle_mute(self):
         self.mute_voice = not self.mute_voice
         self.voice.mute_mode = self.mute_voice
         if self.mute_voice:
             self.btn_sound.configure(text="🔇 Voice Off", fg_color="#4b5563", hover_color="#374151")
         else:
             self.btn_sound.configure(text="🔊 Voice On", fg_color="#3b82f6", hover_color="#2563eb")
             self.speak_and_display("Sound output enabled.")

     def manual_command_prompt(self):
         """Allows typing a command manually for full accessibility."""
         dialog = ctk.CTkInputDialog(text="Enter your command manually, Sir:", title="FRIDAY Interface Console")
         val = dialog.get_input()
         if val:
             self.handle_voice_input(val.strip())

     def log_history(self, speaker, action, details, status):
         """Clean command history panel logger."""
         now = datetime.now().strftime("%H:%M:%S")
         log_entry = f"[{now}] {speaker} -> {action}\nDetail: {details}\nStatus: {status}\n{'-'*35}\n"

         self.history_box.configure(state="normal")
         self.history_box.insert("0.0", log_entry) # Put latest on top
         self.history_box.see("0.0")
         self.history_box.configure(state="disabled")

