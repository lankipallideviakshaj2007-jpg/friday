     def parse_and_execute(self, cmd_text):
         """Normalizes text, removes filler words, extracts clean intent & executes."""
         self.assistant_state = "THINKING"
         self.after(0, lambda: self.response_lbl.configure(text="Parsing command..."))

         # 1. Normalization & Sanitization
         raw_cmd = cmd_text.lower().strip()

         # Remove common filler words
         fillers = ["hey", "please", "can you", "could you", "would you", "now", "friday", "siri", "assistant", "to"]
         words = raw_cmd.split()
         clean_words = [w for w in words if w not in fillers]
         cmd = " ".join(clean_words).strip()

         print(f"[Dashboard] Parsing Normalized Text: '{cmd}'")

         # 2. INTENT MATCHING & EXECUTION
         self.assistant_state = "EXECUTING"

         # Intent A: App Launching (e.g., "open chrome", "launch notepad", "start calculator")
         if any(cmd.startswith(x) for x in ["open ", "launch ", "start "]):
             # Extract target
             target = cmd.replace("open", "").replace("launch", "").replace("start", "").strip()

             # Map aliases
             alias_map = {
                 "google chrome": "chrome",
                 "google": "chrome",
                 "internet browser": "chrome",
                 "text editor": "notepad",
                 "calc": "calculator",
                 "spotify music": "spotify"
             }
             target = alias_map.get(target, target)

             self.after(0, lambda: self.response_lbl.configure(text=f"Opening {target.capitalize()}..."))
             success, message = self.actions.open_application(target)

             if success:
                 self.assistant_state = "SUCCESS"
                 self.speak_and_display(f"Successfully launched {target}, Sir.")
                 self.log_history("User", f"Launch {target}", "Secure Native App Bridge", "Success")
             else:
                 self.assistant_state = "ERROR"
                 self.speak_and_display(f"Access Denied: {message}")
                 self.log_history("User", f"Launch {target}", "Allowlist Blocked / Path Error", "Failed")

         # Intent B: Search Google (e.g., "search for latest news", "google who built the pyramids")
         elif any(cmd.startswith(x) for x in ["search for ", "google ", "search "]):
             query = cmd.replace("search for", "").replace("google", "").replace("search", "").strip()
             self.speak_and_display(f"Searching the web for {query}.")
             self.actions.search_web(query)
             self.assistant_state = "SUCCESS"
             self.log_history("User", "Web Search", f"Query: {query}", "Success")

         # Intent C: Open Safe Websites (e.g., "open youtube", "open wikipedia")
         elif "open website" in cmd or any(cmd.startswith(f"open {s}") for s in ["youtube", "google", "wikipedia", "github", "gmail"]):
             target_site = cmd.replace("open website", "").replace("open", "").strip()
             self.speak_and_display(f"Accessing {target_site} in your default browser.")
             self.actions.open_website(target_site)
             self.assistant_state = "SUCCESS"
             self.log_history("User", "Open Webpage", f"Target: {target_site}", "Success")

         # Intent D: Create / Add a Task (e.g., "create a task complete study report")
         elif "create a task" in cmd or "add task" in cmd or "remind me to" in cmd:
             title, scheduled_time = self.task_manager.parse_task_from_text(cmd_text)
             self.task_manager.add_task(title, scheduled_time)
             self.assistant_state = "SUCCESS"
             self.speak_and_display(f"Task successfully stored: '{title}' for {scheduled_time}.")
             self.log_history("User", "Create Task", f"Task: {title} @ {scheduled_time}", "Success")

         # Intent E: Read Tasks (e.g., "read my tasks", "view reminders", "check my schedule")
         elif any(x in cmd for x in ["read my tasks", "view tasks", "get tasks", "show tasks", "check tasks"]):
             tasks = self.task_manager.get_pending_tasks()
             if not tasks:
                 self.assistant_state = "SUCCESS"
                 self.speak_and_display("Sir, your task list is currently completely empty.")
                 self.log_history("User", "Get Tasks", "Request completed", "Success")
             else:
                 self.assistant_state = "SUCCESS"
                 list_str = ", ".join([f"{t['title']} scheduled at {t['scheduled_time']}" for t in tasks])
                 self.speak_and_display(f"You have {len(tasks)} pending tasks: {list_str}")
                 self.log_history("User", "Get Tasks", f"Found {len(tasks)} tasks", "Success")

         # Intent F: Email Fetching / Summarization (e.g., "check my email", "read mail")
         elif any(x in cmd for x in ["check my email", "check email", "read mail", "check mail"]):
             self.speak_and_display("Accessing secure mail servers...")
             summaries = self.email_manager.fetch_unread_summaries()
             if summaries and "configured" not in summaries[0]:
                 self.assistant_state = "SUCCESS"
                 mail_desc = f"You have {len(summaries)} new unread emails. Here is the latest: {summaries[0].split('Preview:')[0]}"
                 self.speak_and_display(mail_desc)
                 self.log_history("User", "Check Email", f"Fetched {len(summaries)} emails", "Success")
             else:
